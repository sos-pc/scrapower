# Scrapower — Environment variables
# Copy to .env and fill in your credentials

# API
SCRAPOWER_API_KEY=sp-xxxxxxxx

# Network
SCRAPOWER_HOST=0.0.0.0
SCRAPOWER_COORDINATOR_URL=https://your-coordinator.example.com
SCRAPOWER_WG_HOST=your-coordinator.example.com
SCRAPOWER_WG_PASS=your_wireguard_password

# Provider enable/disable (true/false)
KAGGLE_ENABLED=true
MODAL_ENABLED=true

# Kaggle accounts — each account can have "enabled": false to skip it
# Format: [{"username": "...", "token": "...", "enabled": true}]
KAGGLE_ACCOUNTS='[
  {"username": "user1", "token": "xxx", "enabled": true},
  {"username": "user2", "token": "yyy", "enabled": false}
]'

# Modal accounts — same format
# Format: [{"token_id": "...", "token_secret": "...", "enabled": true}]
MODAL_ACCOUNTS='[
  {"token_id": "ak-xxx", "token_secret": "as-xxx", "enabled": true}
]'
# Fallback: single account via env vars (if MODAL_ACCOUNTS not set)
# MODAL_TOKEN_ID=ak-xxx
# MODAL_TOKEN_SECRET=as-xxx

# HuggingFace Spaces (CPU worker)
HF_TOKEN=hf_xxx
HF_SPACE_ID=username/space-name

# Worker liveness (optional). The coordinator presumes a worker dead after
# HEARTBEAT_INTERVAL_SEC * HEARTBEAT_MISS_THRESHOLD seconds of silence, which
# drives both requeue_stale() and the active-worker count. Keep the interval in
# sync with the workers' own heartbeat (30s) — a smaller value requeues live
# workers.
SCRAPOWER_HEARTBEAT_INTERVAL_SEC=30
SCRAPOWER_HEARTBEAT_MISS_THRESHOLD=3

# Blob retention (optional)
SCRAPOWER_BLOB_TTL_DAYS=7
SCRAPOWER_CHECKPOINT_TTL_DAYS=30

# Channel transcription delivery (all optional)
# Local staging dir for rendered transcripts (always written)
SCRAPOWER_TRANSCRIPTS_DIR=data/transcripts
# Google Drive delivery (OAuth user token). Leave empty to disable Drive.
# token.json is produced by the one-time OAuth flow; keep it in data/ (gitignored).
SCRAPOWER_DRIVE_TOKEN=data/drive-token.json
SCRAPOWER_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id
SCRAPOWER_DELIVERY_INTERVAL_SEC=30
